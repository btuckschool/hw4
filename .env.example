# Copy this file to .env (in this folder) and fill in your own values.
# .env is ignored by git, so your real key is never committed.

# Required: Portkey API key used to reach OpenAI's Luna model for the chat assistant.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: use a different model through Portkey (default shown).
# CAMPUS_CUSTOMS_MODEL=gpt-5.6-luna
